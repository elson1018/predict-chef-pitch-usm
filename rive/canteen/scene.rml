        <!-- ========================================================
             INTERACTIVE STATE MACHINE (4 DECOUPLED LAYERS)
             ======================================================== -->
        <StateMachine name="State Machine 1" id="0:7">
            <!-- Layer 1: Scenario Controller (0 = Typical, 1 = Rain, 2 = Festival) -->
            <StateMachineLayer name="ScenarioLayer" id="0:8">
                <AnyState x="0" y="-150"/>
                <ExitState x="600" y="-150"/>
                <EntryState>
                    <StateTransition stateToId="0:111"/>
